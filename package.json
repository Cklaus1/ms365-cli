{
  "name": "ms365-cli",
  "version": "0.1.0",
  "description": "A standalone CLI for Microsoft 365 via Microsoft Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ms365": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "microsoft",
    "365",
    "cli",
    "graph-api"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
