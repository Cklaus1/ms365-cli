{
  "name": "ms365-cli",
  "version": "0.1.0",
  "description": "A standalone CLI for Microsoft 365 via Microsoft Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ms365": "dist/index.js",
    "ms365-remote": "dist/remote.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "microsoft",
    "365",
    "cli",
    "graph-api"
  ],
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "commander": "^11.1.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
