#!/bin/bash
# Stub of libsecret's secret-tool for tests. Items: $STUB_DB/libsecret/<service>/<account>.
db="${STUB_DB:?STUB_DB not set}"
echo "secret-tool $*" >> "$db/argv.log"
case "$STUB_MODE" in
  hang) exec sleep 30 ;;
  fail) echo "secret-tool: Cannot autolaunch D-Bus without X11 \$DISPLAY" >&2; exit 1 ;;
esac
store="$db/libsecret"
cmd="$1"; shift
svc="" acct=""
while [ $# -gt 0 ]; do
  case "$1" in
    --label=*|--all|--unlock) shift ;;
    service) svc="$2"; shift 2 ;;
    account) acct="$2"; shift 2 ;;
    *) shift ;;
  esac
done
case "$cmd" in
  store)
    mkdir -p "$store/$svc"
    cat > "$store/$svc/$acct.tmp.$$" && mv "$store/$svc/$acct.tmp.$$" "$store/$svc/$acct" ;;
  lookup)
    [ -f "$store/$svc/$acct" ] || exit 1
    cat "$store/$svc/$acct" ;;
  clear)
    rm -f "$store/$svc/$acct" ;;
  search)
    found=1
    for f in "$store/$svc"/*; do
      [ -f "$f" ] || continue
      case "$f" in *.tmp.*) continue ;; esac
      found=0
      printf '[/org/freedesktop/secrets/collection/login/1]\nlabel = stub\nsecret = %s\ncreated = 2026-10-15 00:00:00\nschema = org.freedesktop.Secret.Generic\nattribute.service = %s\nattribute.account = %s\n' "$(cat "$f")" "$svc" "$(basename "$f")"
    done
    exit $found ;;
  *) echo "secret-tool: unknown command $cmd" >&2; exit 2 ;;
esac
