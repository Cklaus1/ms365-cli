#!/bin/bash
# Stub of macOS /usr/bin/security for tests (never the real keychain). Items: $STUB_DB/macos/<service>/<account>.
db="${STUB_DB:?STUB_DB not set}"
echo "security $*" >> "$db/argv.log"
case "$STUB_MODE" in
  hang) exec sleep 30 ;;
  fail) echo "security: SecKeychainItemCreateFromContent: User interaction is not allowed." >&2; exit 36 ;;
esac
store="$db/macos"
op() {
  local cmd="$1"; shift
  local svc="" acct="" pw="" print=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -s) svc="$2"; shift 2 ;;
      -a) acct="$2"; shift 2 ;;
      -w) if [ "$cmd" = add-generic-password ]; then pw="$2"; shift 2; else print=1; shift; fi ;;
      *) shift ;;
    esac
  done
  case "$cmd" in
    add-generic-password)
      mkdir -p "$store/$svc"
      printf '%s' "$pw" > "$store/$svc/$acct.tmp.$$" && mv "$store/$svc/$acct.tmp.$$" "$store/$svc/$acct" ;;
    find-generic-password)
      [ -f "$store/$svc/$acct" ] || { echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2; return 44; }
      cat "$store/$svc/$acct"; echo ;;
    delete-generic-password)
      [ -f "$store/$svc/$acct" ] || { echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2; return 44; }
      rm -f "$store/$svc/$acct" ;;
    dump-keychain)
      for f in "$store"/*/*; do
        [ -f "$f" ] || continue
        case "$f" in *.tmp.*) continue ;; esac
        printf 'keychain: "/Users/stub/Library/Keychains/login.keychain-db"\nversion: 512\nclass: "genp"\nattributes:\n    "acct"<blob>="%s"\n    "svce"<blob>="%s"\n' "$(basename "$f")" "$(basename "$(dirname "$f")")"
      done ;;
    *) echo "security: unknown command $cmd" >&2; return 1 ;;
  esac
}
if [ "$1" = -i ]; then
  rc=0
  while read -r line; do
    [ -n "$line" ] || continue
    # shellcheck disable=SC2086
    op $line || rc=$?
  done
  exit $rc
fi
op "$@"
